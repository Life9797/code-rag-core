# Copy to .env (never commit .env). Passwords: superuser (init only) and the shared password of the service logins.
POSTGRES_PASSWORD=change-me
DB_PASSWORD=change-me-too
API_PORT=8088
# Host folders (relative to deploy/): DATA_DIR holds vol/ and keys/; MODELS_DIR holds bge-m3/ for TEI.
DATA_DIR=../data
MODELS_DIR=../models
# embed = start bge-m3 on TEI here; empty when EMBED_URL points to an embedding server you already run
COMPOSE_PROFILES=embed
#EMBED_URL=http://my-tei:80
PG_IMAGE=pgvector/pgvector:0.8.1-pg18
EMBED_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.8
# Embedding identity is part of the vector config hash: change it when the weights change.
EMBED_MODEL_ID=bge-m3@main
# Your existing vLLM (memory 2026-10-15 site values). Empty LLM_URL = stub summaries (no LLM).
LLM_NETWORK=ollama_ollama_network
LLM_URL=http://vllm-server:8000
LLM_SERVED_NAME=/models/gpt-oss-120b-awq
LLM_REVISION=gpt-oss-120b-awq-v1
LLM_MAX_TOKENS=2048
LLM_JSON_MODE=0
LLM_REASONING_EFFORT=low
# Your existing Open WebUI network when it differs from LLM_NETWORK (code-rag answers there as coderag-api:8080).
WEBUI_NETWORK=
# Admin page: http://<host>:API_PORT/admin (sign in with a service client, e.g. the Open WebUI one, role 4 = tenant admin).
# Keycloak sign-in (optional, off while empty). Keycloak: realm client "coderag-admin", public client, standard flow,
# valid redirect URI http://<host>:API_PORT/admin, web origin http://<host>:API_PORT. OIDC_ISSUER is the realm URL as the
# browser sees it (= the token's iss); OIDC_JWKS_URL only when the api reaches Keycloak by another name.
# First Keycloak login shows issuer + subject; link it under 사용자·클라이언트 > 사람 추가, or for the platform admin:
#   bash deploy/dc.sh run --rm init python -m coderag_core.coreadm link-identity <principal> <issuer> <subject>
OIDC_ISSUER=
OIDC_CLIENT_ID=coderag-admin
OIDC_AUDIENCE=
OIDC_JWKS_URL=
